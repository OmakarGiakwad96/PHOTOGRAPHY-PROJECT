# ============================================
# PhotoHub .NET Backend — Dockerfile.vercel
# ASP.NET Core 8.0 application
# ============================================

# Stage 1: Build the .NET application
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project file and restore dependencies (cached layer)
COPY ["PhotoHub.Api.csproj", "./"]
RUN dotnet restore "./PhotoHub.Api.csproj"

# Copy everything else and publish
COPY . .
RUN dotnet publish "PhotoHub.Api.csproj" -c Release -o /app/publish

# Stage 2: Run the application
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

COPY --from=build /app/publish .

# Vercel injects PORT env variable at runtime (defaults to 80)
# ASP.NET Core Kestrel binds to 0.0.0.0:$PORT
# We use a shell entrypoint to resolve the PORT variable dynamically
ENTRYPOINT ["sh", "-c", "ASPNETCORE_URLS=http://+:${PORT:-5000} dotnet PhotoHub.Api.dll"]
