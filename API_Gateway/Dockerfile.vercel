# ============================================
# PhotoHub API Gateway — Dockerfile.vercel
# Node.js Express proxy server
# ============================================

FROM node:20-alpine
WORKDIR /app

# Copy package files and install production dependencies only
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy source code
COPY . .

# Vercel injects the PORT env variable at runtime (defaults to 80)
# The gateway reads PORT from process.env in src/config/gateway.js
ENV NODE_ENV=production

# Start the API Gateway
CMD ["node", "src/server.js"]
