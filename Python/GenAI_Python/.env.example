# Copy this file to ".env" and fill in your local values.
# These should match your Spring Boot backend's application.properties
# (same database, since the chatbot reads photohub_db directly).

# ---------------- MySQL (photohub_db) ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=manager
DB_NAME=photohub_db

# ---------------- Ollama ----------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
