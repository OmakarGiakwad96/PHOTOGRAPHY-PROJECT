# ==============================================================================
# PhotoHub Connect - Production & Development Environment Configuration
# ==============================================================================

# --- Application Domain ---
PUBLIC_APP_URL=https://www.photohubconnect.store
APP_BASE_URL=https://www.photohubconnect.store
PORT=3000

# --- Razorpay Payment Gateway ---
# Generate keys from https://dashboard.razorpay.com/ -> Account & Settings -> API Keys
# Test keys format: rzp_test_xxxxxxxxxxxxxx
# Live keys format: rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Frontend Razorpay Public Key (exposed to client bundle)
VITE_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=yourSecureRootPassword
MYSQL_DATABASE=photohub_db
MYSQL_USER=photohub_user
MYSQL_PASSWORD=yourSecureUserPassword
MYSQL_PORT=3306

# .NET Database Connection String
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=photohub_db;User=photohub_user;Password=yourSecureUserPassword;

# Spring Boot Database URL
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/photohub_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=photohub_user
SPRING_DATASOURCE_PASSWORD=yourSecureUserPassword

# --- API Gateway Routing Targets ---
JAVA_TARGET=http://springboot-backend:8080
DOTNET_TARGET=http://dotnet-service:5000
PYTHON_TARGET=http://python-fastapi:8000

# --- OTP & Security Controls ---
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRY_MINUTES=15

# --- Transactional Email Integration (Resend / SMTP) ---
# Sign up at https://resend.com/ -> API Keys -> Create API Key
# Add and verify your domain at https://resend.com/domains (e.g. photohubconnect.store)
EMAIL_PROVIDER=Resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@photohubconnect.store
EMAIL_FROM_NAME=PhotoHub Connect

# Optional SMTP Fallback (Gmail / Amazon SES / Brevo)
Email__Provider=Resend
Email__ResendApiKey=re_your_resend_api_key_here
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=notifications@photohubconnect.store
Email__SmtpPassword=your_smtp_app_password
Email__FromEmail=noreply@photohubconnect.store
Email__FromName=PhotoHub Connect
Email__EnableSsl=true
Email__UseMockProvider=true

# --- Real SMS OTP & Notifications (MSG91 / 2Factor / Indian Telecom DLT) ---
# Telecom DLT (TRAI) Mandatory Registration:
# 1. Register Principal Entity on Telecom DLT portal (Jio DLT / Airtel DLT / Vilpower / Ping-Connect).
# 2. Register Header (Sender ID): e.g. PHOHUB (6 capital characters).
# 3. Register Content Template (Transactional / Service Implicit):
#    Template: "Your PhotoHub Connect verification code is {#var#}. Valid for {#var#} minutes. Do not share this code. - PHOHUB"
# 4. Map DLT PE ID and Template ID into MSG91 (https://control.msg91.com/) Flow builder.
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=your_msg91_authkey
MSG91_SENDER_ID=PHOHUB
MSG91_TEMPLATE_ID=your_registered_dlt_template_id
MSG91_DLT_TE_ID=your_registered_dlt_template_id
MSG91_DLT_PE_ID=your_registered_dlt_principal_entity_id

# Optional 2Factor SMS Provider alternative
TWOFACTOR_API_KEY=your_2factor_api_key_here

# ASP.NET Nested Configuration for SMS (Host Environment Format)
SMS__Provider=MSG91
SMS__AuthKey=your_msg91_authkey
SMS__SenderId=PHOHUB
SMS__TemplateId=your_registered_dlt_template_id
SMS__EntityId=your_registered_dlt_principal_entity_id
SMS__Route=4
SMS__UseMockProvider=true

# --- Meta WhatsApp Business Cloud API ---
# Configure in Meta for Developers (https://developers.facebook.com/) -> WhatsApp -> API Setup
# Webhook URL: https://www.photohubconnect.store/api/notifications/whatsapp/webhook
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=photohub_wa_verify_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret

# ASP.NET Nested Configuration for WhatsApp (Host Environment Format)
WhatsApp__PhoneNumberId=your_meta_phone_number_id
WhatsApp__AccessToken=your_meta_system_user_access_token
WhatsApp__BusinessAccountId=your_meta_business_account_id
WhatsApp__ApiVersion=v20.0
WhatsApp__VerifyToken=photohub_wa_verify_token_2026
WhatsApp__AppSecret=your_meta_app_secret
WhatsApp__UseMockProvider=true
