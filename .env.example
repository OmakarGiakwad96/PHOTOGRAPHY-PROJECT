# ==============================================================================
# PhotoHub Connect - Production & Development Environment Configuration
# ==============================================================================

# --- Application Domain ---
PUBLIC_APP_URL=https://www.photohubconnect.store
PORT=3000

# --- Razorpay Payment Gateway ---
# Generate keys from https://dashboard.razorpay.com/ -> Account & Settings -> API Keys
# Test keys format: rzp_test_xxxxxxxxxxxxxx
# Live keys format: rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Frontend Razorpay Public Key (exposed to client bundle)
VITE_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=yourSecureRootPassword
MYSQL_DATABASE=photohub_db
MYSQL_USER=photohub_user
MYSQL_PASSWORD=yourSecureUserPassword
MYSQL_PORT=3306

# .NET Database Connection String
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=photohub_db;User=photohub_user;Password=yourSecureUserPassword;

# Spring Boot Database URL
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/photohub_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=photohub_user
SPRING_DATASOURCE_PASSWORD=yourSecureUserPassword

# --- API Gateway Routing Targets ---
JAVA_TARGET=http://springboot-backend:8080
DOTNET_TARGET=http://dotnet-service:5000
PYTHON_TARGET=http://python-fastapi:8000

# --- Email & Transactional Notifications (SMTP) ---
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=notifications@photohubconnect.store
Email__SmtpPassword=your_smtp_app_password
Email__FromEmail=noreply@photohubconnect.store
Email__FromName=PhotoHub Connect
Email__EnableSsl=true
Email__UseMockProvider=true

# --- SMS Notifications (Twilio / Fast2SMS) ---
SMS__Provider=Twilio
SMS__AccountSid=your_account_sid
SMS__AuthToken=your_auth_token
SMS__FromPhoneNumber=+18005550199
SMS__UseMockProvider=true
